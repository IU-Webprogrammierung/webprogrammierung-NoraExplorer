    </nav>

    <!-- Mobile Menü (Burger-)Button (links)-->
    <button class="icon-button" type="button" id="navToggle" aria-controls="mobileNav" aria-expanded="false" aria-label="Menü öffnen">
        <!-- SVG stammt von https://heroicons.com -->
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
    </button>

    <!-- Logo (mitte, nur in der Mobile-Version)-->
    <div class="header__center">
        <a class="icon-button header__logo" href="index.html" aria-label="Startseite" data-tooltip="Startseite">
            <!-- Eigene SVG -->
            <img class="header__logo-img header__logo-img--darkmode" src="images/ui/logo-nora-mikus-darkmode.svg" alt="Logo von Nora Mikus">
            <img class="header__logo-img header__logo-img--lightmode" src="images/ui/logo-nora-mikus.svg" alt="Logo von Nora Mikus">
        </a>
    </div>

    <!-- Einstellungen (rechts)-->
