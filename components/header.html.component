<!--
    Header Komponente:
    wird per layout-include.js in <header id="site-header"> nachgeladen.
    Enthält Desktop-Navigation sowie Mobile-Navigation mit Overlay und Offcanvas-Panel.
-->

<div class="header__inner header__inner--mobilebar">
    <!-- Desktop-Navigation -->
    <nav id="main-nav" class="main-nav" aria-label="Hauptnavigation">
        <ul class="main-nav__list">
            <li class="main-nav__item main-nav__item--home">
                <a
                    class="main-nav__home-link icon-button"
                    href="/index.html"
                    aria-label="Startseite"
                    data-page="index"
                    data-tooltip="Startseite"
                >
                    <img
                        class="main-nav__logo-img main-nav__logo-img--darkmode"
                        src="/images/ui/logo-nora-mikus-darkmode.svg"
                        alt=""
                        aria-hidden="true"
                    >
                    <img
                        class="main-nav__logo-img main-nav__logo-img--lightmode"
                        src="/images/ui/logo-nora-mikus.svg"
                        alt=""
                        aria-hidden="true"
                    >
                </a>
            </li>

            <li class="main-nav__item">
                <a class="nav-link" href="/ueber.html" data-page="ueber">Über mich</a>
            </li>
            <li class="main-nav__item">
                <a class="nav-link" href="/fotografie.html" data-page="fotografie">Fotografie</a>
            </li>
            <li class="main-nav__item">
                <a class="nav-link" href="/projekte.html" data-page="projekte">Projekte</a>
            </li>
            <li class="main-nav__item">
                <a class="nav-link" href="/prozess.html" data-page="prozess">Prozess</a>
            </li>
        </ul>
    </nav>

    <!-- Mobile-Navigation: Trigger -->
    <button
        id="navToggle"
        class="header__toggle icon-button"
        type="button"
        aria-controls="mobileNav"
        aria-expanded="false"
        aria-haspopup="dialog"
        aria-label="Menü öffnen"
    >
        <!-- SVG stammt von https://heroicons.com -->
        <svg
            class="size-6"
            aria-hidden="true"
            focusable="false"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
        >
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"
            />
        </svg>
    </button>

    <!-- Mobile-Navigation: zentriertes Header-Logo -->
    <div class="header__center">
        <a
            class="header__logo icon-button"
            href="/index.html"
            aria-label="Startseite"
            data-page="index"
            data-tooltip="Startseite"
        >
            <img
                class="header__logo-img header__logo-img--darkmode"
                src="/images/ui/logo-nora-mikus-darkmode.svg"
                alt=""
                aria-hidden="true"
            >
            <img
                class="header__logo-img header__logo-img--lightmode"
                src="/images/ui/logo-nora-mikus.svg"
                alt=""
                aria-hidden="true"
            >
        </a>
    </div>

    <!-- Header-Actions -->
    <div class="header__actions">
        <a
            class="header__settings icon-button"
            href="/einstellungen.html"
            aria-label="Einstellungen"
            data-page="einstellungen"
            data-tooltip="Einstellungen"
        >
            <!-- SVG stammt von https://heroicons.com -->
            <svg
                class="size-6"
                aria-hidden="true"
                focusable="false"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z"
                />
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"
                />
            </svg>
        </a>
    </div>
</div>

<!-- Mobile-Navigation: Overlay -->
<!-- Initial verborgen; wird per JS geöffnet bzw. geschlossen -->
<div id="navOverlay" class="nav-overlay" hidden aria-hidden="true"></div>

<!-- Mobile-Navigation -->
<!-- Interaktiv als modaler Dialog, inhaltlich Navigation -->
<aside
    id="mobileNav"
    class="mobile-nav"
    role="dialog"
    aria-modal="true"
    aria-labelledby="mobileNavTitle"
    aria-hidden="true"
    hidden
    inert
>
    <!-- Mobile-Navigation: Kopfbereich -->
    <div class="mobile-nav__header">
        <h2 id="mobileNavTitle" class="mobile-nav__title">Menü</h2>

        <button
            type="button"
            class="mobile-nav__close icon-button"
            data-nav-close
            aria-label="Menü schließen"
        >
            <!-- SVG stammt von https://heroicons.com -->
            <svg
                class="size-6"
                aria-hidden="true"
                focusable="false"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M6 18 18 6M6 6l12 12"
                />
            </svg>
        </button>
    </div>

    <!-- Mobile-Navigation: primäre Links -->
    <nav class="mobile-nav__primary" aria-label="Hauptnavigation">
        <ul class="mobile-nav__list mobile-nav__list--primary">
            <li class="mobile-nav__item">
                <a class="nav-link" href="/index.html" data-page="index">Startseite</a>
            </li>
            <li class="mobile-nav__item">
                <a class="nav-link" href="/ueber.html" data-page="ueber">Über mich</a>
            </li>
            <li class="mobile-nav__item">
                <a class="nav-link" href="/fotografie.html" data-page="fotografie">Fotografie</a>
            </li>
            <li class="mobile-nav__item">
                <a class="nav-link" href="/projekte.html" data-page="projekte">Projekte</a>
            </li>
            <li class="mobile-nav__item">
                <a class="nav-link" href="/prozess.html" data-page="prozess">Prozess</a>
            </li>
        </ul>
    </nav>

    <!-- Mobile-Navigation: sekundäre Links -->
    <nav class="mobile-nav__secondary" aria-label="Sekundäre Navigation">
        <ul class="mobile-nav__list mobile-nav__list--secondary">
            <li class="mobile-nav__item">
                <a class="nav-link" href="/einstellungen.html" data-page="einstellungen">Einstellungen</a>
            </li>
            <li class="mobile-nav__item">
                <a class="nav-link" href="/impressum.html" data-page="impressum">Impressum</a>
            </li>
        </ul>
    </nav>
</aside>