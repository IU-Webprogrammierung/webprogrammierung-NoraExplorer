<!-- 
    Header Komponente:
    wird per layout-include.js in <header id="site-header"> nachgeladen.
    Enthält Desktop-Navigation & Mobile-Navigation inklusive Offcanvas und Overlay
-->

<div class="header__inner header__inner--mobilebar">
    <!-- Desktop Navigation -->
    <nav id="main-nav" class="main-nav" aria-label="Hauptseiten">
        <ul>
            <li class="main-nav__home">
                <a class="main-nav__home-link" href="index.html" aria-label="Startseite" data-page="index" data-tooltip="Startseite">
                    <img class="main-nav__logo-img main-nav__logo-img--darkmode" src="images/ui/logo-nora-mikus-darkmode.svg" alt="Logo von Nora Mikus" aria-hidden="true">
                    <img class="main-nav__logo-img main-nav__logo-img--lightmode" src="images/ui/logo-nora-mikus.svg" alt="Logo von Nora Mikus">
                </a>
            </li>

            <li class="main-nav__divider" aria-hidden="true"></li>

            <li><a class="nav-link" href="ueber.html" data-page="ueber">Über mich</a></li>
            <li><a class="nav-link" href="fotografie.html" data-page="fotografie">Fotografie</a></li>
            <li><a class="nav-link" href="projekte.html" data-page="projekte">Projekte</a></li>
            <li><a class="nav-link" href="prozess.html" data-page="prozess">Prozess</a></li>
